{
  "name": "editingapp-retro-portraits",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fal:discover": "node --env-file-if-exists=.env.local scripts/fal-catalog.mjs",
    "billing:setup": "node --env-file-if-exists=.env.local scripts/setup-stripe.mjs",
    "seo:export": "node scripts/export-search-console.mjs",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
