# Server-only. Never put secrets in NEXT_PUBLIC_* variables.
# fal key with credits and access to openai/gpt-image-2.5/sunburst/edit.
FAL_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact browser origin, no trailing slash. Replace before production.
APP_URL=http://localhost:3000
# Enable only AFTER applying 202609130001_credits_billing_figures.sql.
# False preserves the legacy retro allowance while billing is being configured.
CREDITS_ENABLED=false
# Server-only Stripe configuration; use test mode during payment verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Products, prices and the portal configuration are resolved automatically in Stripe.
# Optional: Google's HTML-tag verification content value only (no HTML).
# Keep existing DNS/file verification if already verified. Feature changes do not need a new property.
# GOOGLE_SITE_VERIFICATION=
# Optional: only needed if you enable scheduled private-photo cleanup.
# Generation and manual deletion work without this. The cleanup endpoint stays locked.
# CRON_SECRET=
